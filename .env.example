# Moodboard Motion Vault - Environment Configuration
# Copy this file to .env for local development (do NOT commit .env to git)

# 1. GitHub Personal Access Token (classic) with 'repo' scope
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# 2. Admin password (plaintext - verified server-side against the hash in admin.html)
ADMIN_PASSWORD=your_new_secret_password_here

# 3. Optional: Netlify Build Hook URL for instant deploy triggers
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/your_build_hook_id
